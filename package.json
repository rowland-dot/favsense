{
  "name": "favsense-xhs",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Xiaohongshu and RedNote favorites organizer with user-triggered sync, video analysis, a resource index, and a static knowledge-base UI.",
  "keywords": [
    "xiaohongshu",
    "rednote",
    "favorites-manager",
    "bookmark-organizer",
    "knowledge-base",
    "local-first",
    "video-analysis",
    "resource-index",
    "tampermonkey"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowland-dot/favsense.git"
  },
  "homepage": "https://github.com/rowland-dot/favsense#readme",
  "bugs": {
    "url": "https://github.com/rowland-dot/favsense/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preview": "node scripts/serve-site.mjs",
    "preview:qa-fixture": "node scripts/serve-qa-fixture.mjs",
    "test:site": "node --test skills/xhs-favorites-organizer/tests/test_public_site.mjs skills/xhs-favorites-organizer/tests/share-link-background.test.mjs skills/xhs-favorites-organizer/tests/open-original-docs.test.mjs skills/xhs-favorites-organizer/tests/bridge-reply-and-media-failure.test.mjs skills/xhs-favorites-organizer/tests/legacy-safety-stop-status.test.mjs skills/xhs-favorites-organizer/tests/safety-signal-userscript.test.mjs skills/xhs-favorites-organizer/tests/run-state-cases.test.mjs skills/xhs-favorites-organizer/tests/workbench-running-check.test.mjs skills/xhs-favorites-organizer/tests/single-page-userscript.test.mjs skills/xhs-favorites-organizer/tests/diandian-summary-display.test.mjs",
    "test:publish": "node --test skills/xhs-favorites-organizer/tests/test_huggingface_publish.mjs skills/xhs-favorites-organizer/tests/publisher-local-exclusion.test.mjs",
    "test:knowledge": "node --test skills/xhs-favorites-organizer/tests/test_formal_outputs.mjs skills/xhs-favorites-organizer/tests/public-judgement.test.mjs skills/xhs-favorites-organizer/tests/public-judgement-builders.test.mjs skills/xhs-favorites-organizer/tests/private-output-short-path.test.mjs skills/xhs-favorites-organizer/tests/test_organization_snapshot.mjs skills/xhs-favorites-organizer/tests/web-only-snapshot.test.mjs skills/xhs-favorites-organizer/tests/site-code-in-build-version.test.mjs skills/xhs-favorites-organizer/tests/organize-paragraphs.test.mjs skills/xhs-favorites-organizer/tests/extracted-text.test.mjs skills/xhs-favorites-organizer/tests/card-content.test.mjs skills/xhs-favorites-organizer/tests/damaged-replies.test.mjs skills/xhs-favorites-organizer/tests/faithful-cards-builder.test.mjs skills/xhs-favorites-organizer/tests/faithful-cards-public-safety.test.mjs skills/xhs-favorites-organizer/tests/faithful-cards-boundaries.test.mjs",
    "test:curation": "node --test skills/xhs-favorites-organizer/tests/test_curation_standard.mjs skills/xhs-favorites-organizer/tests/stable-curation-rebuild.test.mjs skills/xhs-favorites-organizer/tests/verify-github-resources.test.mjs skills/xhs-favorites-organizer/tests/reviewed-evidence-only-rebuild.test.mjs skills/xhs-favorites-organizer/tests/verification-max-age.test.mjs skills/xhs-favorites-organizer/tests/verification-max-age-migration.test.mjs skills/xhs-favorites-organizer/tests/exact-file-identity.test.mjs skills/xhs-favorites-organizer/tests/organization-lock-handoff.test.mjs skills/xhs-favorites-organizer/tests/image-text-evidence-required.test.mjs skills/xhs-favorites-organizer/tests/diandian-refusal.test.mjs skills/xhs-favorites-organizer/tests/accepted-text-quality.test.mjs skills/xhs-favorites-organizer/tests/curation-action-optional.test.mjs skills/xhs-favorites-organizer/tests/ci-release-gate-steps.test.mjs skills/xhs-favorites-organizer/tests/faithful-cards-docs.test.mjs",
    "test:skill-sync": "node --test scripts/test-sync-diandian-skill.mjs",
    "test:release-contracts": "node --test scripts/test-run-python-tests.mjs scripts/test-verify-release.mjs scripts/test-connection-log.mjs scripts/test-check-test-script-paths.mjs",
    "test:lifecycle": "node --test scripts/test-verify-development-lifecycle.mjs scripts/test-check-syntax.mjs scripts/test-run-organization-tests.mjs",
    "test:organization": "node scripts/run-organization-tests.mjs",
    "verify:github-resources": "node skills/xhs-favorites-organizer/scripts/verify-github-resources.mjs",
    "test:e2e": "playwright test",
    "test:windows-contracts": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File skills/xhs-favorites-organizer/tests/test_setup_browser_profile.ps1 -ScriptPath skills/xhs-favorites-organizer/scripts/setup-autosync.ps1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File skills/xhs-favorites-organizer/tests/test_setup_transaction.ps1 -ScriptPath skills/xhs-favorites-organizer/scripts/setup-autosync.ps1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File skills/xhs-favorites-organizer/tests/test_setup_xhs_downloader.ps1 -ScriptPath skills/xhs-favorites-organizer/scripts/setup-xhs-downloader.ps1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File skills/xhs-favorites-organizer/tests/test_start_autosync.ps1 -ScriptPath \"%CD%/skills/xhs-favorites-organizer/scripts/start-autosync.ps1\"",
    "lint:a11y": "eslint site/app.js site/local-bridge-utils.mjs site/resource-utils.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:python": "node scripts/run-python-tests.mjs",
    "check:test-paths": "node scripts/check-test-script-paths.mjs",
    "test": "npm run check:test-paths && npm run test:site && npm run test:publish && npm run test:knowledge && npm run test:curation && npm run test:skill-sync && npm run test:release-contracts && npm run test:lifecycle",
    "verify": "node scripts/verify-release.mjs",
    "release:check": "npm run check:syntax && npm run lint:a11y && npm test && npm run test:organization && npm run test:python && npm run test:e2e && npm run verify"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2"
  },
  "dependencies": {
    "js-yaml": "^4.3.1"
  }
}
